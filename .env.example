# Copy this file to .env and fill in your keys.
# .env is git-ignored and must never be committed.

GROQ_API_KEY=gsk_your_groq_key_here
TAVILY_API_KEY=tvly_your_tavily_key_here

# Google Calendar — OAuth2 Desktop credentials from Google Cloud Console.
# Download as JSON and save to zeev/data/gcal_credentials.json.
# Run `pip3 install google-api-python-client google-auth-httplib2 google-auth-oauthlib`
# On first run Zeev will print an auth URL — open it on any device, paste the code back.

# --- multi-provider config ---

# LLM provider: groq (default) | openai | anthropic | gemini | ollama | openrouter
LLM_SERVER=groq

# STT provider: groq (default) | openai | vosk | faster-whisper
STT_SERVER=groq

# TTS provider: auto (default) | elevenlabs | orpheus | openai | piper | gtts | espeak
#   auto picks ElevenLabs first (if key set), then Orpheus, then gTTS/piper
TTS_SERVER=auto

# Provider API keys (only needed for the provider you select)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ElevenLabs TTS — best quality, Southern accent voices available
# Sign up at https://elevenlabs.io (free tier: 10k chars/month)
# Browse voices: https://elevenlabs.io/voice-library (filter: American → Southern)
# Paste your chosen voice ID below. Default "Matilda" is warm American female.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=MgqVq3OCTPeVHCEDr4HU

# Ollama settings (if LLM_SERVER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI TTS/STT options
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1

# Wake word (openwakeword)  — requires: pip install openwakeword numpy  +  apt install sox
# --- openWakeWord (device mode local wake detection) ---
# Unset OWW_MODEL_PATH and device mode falls back to matching the wake phrase
# via cloud STT, which bills Groq for every noisy 2-second window the mic hears
# (at a 10-second minimum per request) and ships room audio off-device.
#
# Install: pip3 install --user --break-system-packages onnxruntime openwakeword
#   (resolves 0.4.0 on py3.13/aarch64 -- newer releases need tflite-runtime,
#    which has no wheel there. 0.4.0 is onnx-only and bundles its models.)
#
# Stock models ship with the package, e.g.
#   ~/.local/lib/python3.13/site-packages/openwakeword/resources/models/hey_jarvis_v0.1.onnx
# For a custom phrase, train a .onnx with openWakeWord's automatic training
# notebook (free, ~75-90 min unattended on a Colab T4) and point at it here.
OWW_MODEL_PATH=
OWW_THRESHOLD=0.5
OWW_COOLDOWN=2.0
