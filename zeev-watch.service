[Unit]
Description=Zeev watch-command endpoint (Zepp OS app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ragnar
WorkingDirectory=/home/ragnar/Zeev
EnvironmentFile=/home/ragnar/Zeev/.env
ExecStart=/usr/bin/python3 zeev/watch_server.py --port 5050
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
