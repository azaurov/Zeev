#!/bin/bash
# Bluetooth HFP pairing wizard for Zeev Pi
# Usage: /bt-pair-phone

set -e

PI_HOST="${1:-ragnar@10.0.0.168}"
SCAN_TIMEOUT=15

echo "🔍 Bluetooth HFP Pairing Wizard"
echo "================================"
echo ""
echo "Make sure your phone's Bluetooth is ON and in pairing mode."
echo "Scanning for $SCAN_TIMEOUT seconds..."
echo ""

# SSH into Pi and run the pairing wizard
ssh "$PI_HOST" bash << 'SCRIPT'
set -e

# Function to run bluetoothctl commands
run_bt() {
    echo "$1" | bluetoothctl
}

# Get list of currently paired devices before scan
echo "[*] Checking for already-paired devices..."
paired_before=$(bluetoothctl paired-devices 2>/dev/null | awk '{print $2}' | tr '[:lower:]' '[:upper:]' || echo "")

# Scan for new devices
echo "[*] Scanning for 15 seconds (put phone in pairing mode NOW if not already)..."
timeout 15 bluetoothctl scan on 2>/dev/null || true

# Get list of all devices
echo "[*] Finding your phone..."
all_devices=$(bluetoothctl devices 2>/dev/null)

# Try to find unpaired phones by comparing before/after
# Or just list all and let user pick
device_count=$(echo "$all_devices" | wc -l)

if [ "$device_count" -eq 0 ]; then
    echo "❌ No devices found. Make sure your phone's Bluetooth is ON and in pairing mode."
    exit 1
fi

echo ""
echo "📱 Found devices:"
echo "$all_devices" | nl -w2 -s') '

echo ""
read -p "Enter device number (1-$device_count): " choice
choice=$((choice - 1))

device_line=$(echo "$all_devices" | sed -n "$((choice+1))p")
phone_mac=$(echo "$device_line" | awk '{print $2}')
phone_name=$(echo "$device_line" | cut -d' ' -f3-)

if [ -z "$phone_mac" ]; then
    echo "❌ Invalid selection."
    exit 1
fi

echo ""
echo "🔗 Pairing with: $phone_name ($phone_mac)"
echo ""

# Pair
echo "[1/3] Pairing..."
echo "pair $phone_mac" | bluetoothctl 2>&1 | grep -E "Pairing|successful|already"
sleep 2

# Trust
echo "[2/3] Trusting device..."
echo "trust $phone_mac" | bluetoothctl 2>&1 | grep -E "Trust|successful|already"
sleep 1

# Connect
echo "[3/3] Connecting..."
echo "connect $phone_mac" | bluetoothctl 2>&1 | grep -E "Connection|successful|Authorize"
sleep 3

# Verify HFP is available
echo ""
echo "✅ Verifying HFP connection..."
hfp_check=$(bluealsa-aplay --list-pcms 2>/dev/null | grep "PROFILE=sco" | head -1)

if [ -n "$hfp_check" ]; then
    echo "✨ Success! HFP SCO connection ready:"
    bluealsa-aplay --list-pcms | grep -A2 "PROFILE=sco" | head -4
    echo ""
    echo "Your phone is now ready for calls. Use: call <number>"
else
    echo "⚠️  HFP not yet available. Try running 'sudo systemctl restart bluealsa' on the Pi:"
    echo "  ssh ragnar@10.0.0.168 'sudo systemctl restart bluealsa && sleep 2 && bluealsa-aplay --list-pcms'"
fi

SCRIPT

echo ""
echo "✅ Pairing complete!"
