{
  "permissions": {
    "allow": [
      "Bash(journalctl *)",
      "Bash(systemctl status *)",
      "Bash(php -l *)",
      "Bash(sudo systemctl restart zeev-device)",
      "Bash(sudo systemctl restart zeev-device && *)",
      "Bash(ssh ragnar@ragnarok 'python3 << *)",
      "Bash(ssh ragnar@ragnarok 'cd /home/ragnar/Zeev && python3 << *)",
      "Bash(ssh ragnar@ragnarok 'cd *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -Eq '(cat|less|head|tail|echo).*\\.env' && { echo 'BLOCKED: refusing to dump .env — print key NAMES only' >&2; exit 2; }; exit 0"
          }
        ]
      }
    ]
  }
}
