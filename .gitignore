# llama.cpp binaries and shared libs
zeev/bin/

# Go audio daemon compiled binaries
zeev-audio/bin/

# Model weights
zeev/models/

# Runtime data — all personal/session files are private
zeev/data/
!zeev/data/adult_jokes*.json
!zeev/data/stt_vocabulary.txt

# Python
__pycache__/
*.pyc

# Claude Code local settings
.claude/settings.local.json

# Environment secrets — never commit the real .env
.env
# Key rotations leave timestamped copies next to it, and those hold live
# credentials too. Only `.env` itself was ignored, so a `git add -A` during a
# rotation would have staged one.
.env.*
!.env.example

# Personal call scripts
zeev/quantum_convo.py

# Generated LCD preview images
zeev/previews/

# Added by ggshield
.cache_ggshield

# Compiled Go daemon — built with `make pi`, deployed to ~/zeev-audio/ on the Pi
zeev-audio/zeev-audio
zeev-audio/bin/
